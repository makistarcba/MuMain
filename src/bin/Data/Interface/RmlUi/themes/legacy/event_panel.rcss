/* VORTHANIA: legacy theme for the event panel (CEventPanelWindow). C++ places and sizes the box
   in physical px (top-right corner of the window, at the UI scale); here only the look: black at
   80% in a black frame, like the F1 help. Spacing in em of the native text size. */

body { pointer-events: none; }

#event_box {
	box-sizing: border-box;
	position: absolute;
	border-width: 1px;
	border-color: #000000;
	background-color: rgba(0, 0, 0, 204);
	font-family: "token(font-body)";
	color: #dcdcdc;
	line-height: 1.3em;
}

.ev-title { display: block; text-align: center; font-weight: bold; color: #ffdc78; }
.ev-clock { display: block; text-align: center; color: #aaaaaa; margin-bottom: 0.4em; }
.ev-line { display: block; white-space: nowrap; overflow: hidden; margin-bottom: 0.1em; }
.ev-line.indent1 { padding-left: 0.8em; }
.ev-line.indent2 { padding-left: 1.6em; }
.ev-right { float: right; padding-left: 0.4em; }
.ev-footer { display: block; text-align: center; color: #787878; margin-top: 0.4em; }
