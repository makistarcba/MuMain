<rml>
<head>
	<title>Eventos</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="event_panel.rcss"/>
</head>
<!-- VORTHANIA: the event panel (key H, CEventPanelWindow). Laid out in physical window px: C++
     places the box at the window's top-right corner at the UI scale (panel_left/top/width) and gives
     the native text size; spacing is in em of that size. The mouse goes through it, like the F1
     help; H or Escape closes it. -->
<body data-model="event_panel">
	<div id="event_box"
	     data-style-left="panel_left + 'px'" data-style-top="panel_top + 'px'" data-style-width="panel_width + 'px'"
	     data-style-font-size="text_px + 'px'" data-style-padding="gap + 'px'">
		<div class="ev-title" data-style-font-size="bold_text_px + 'px'">Eventos</div>
		<div class="ev-clock" data-if="server_time != ''">{{server_time}}</div>
		<div class="ev-line" data-for="line : lines" data-class-indent1="line.indent == 1" data-class-indent2="line.indent == 2"><span class="ev-right" data-if="line.right != ''"
		       data-style-color="line.right_color">{{line.right}}</span><span class="ev-left"
		       data-style-color="line.color">{{line.left}}</span></div>
		<div class="ev-footer">H o Esc para cerrar</div>
	</div>
</body>
</rml>
